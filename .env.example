# Copie ce fichier en .env et renseigne ta clé API Gemini
# Clé gratuite : https://aistudio.google.com/apikey
GEMINI_API_KEY=AIza...

# Optionnel : modèle (par défaut gemini-3.8-flash)
ANALYSE_MODEL=gemini-3.8-flash

# Optionnel : budget par action en euros (par défaut 500)
ALLOCATION_PAR_ACTION=500
